{
  "baseBranch": "main",
  "branchPrefix": "crew/",
  "issues": { "github": true },
  "delivery": { "mode": "github", "remote": "origin" },
  "sensitivePaths": ["(^|/)package-lock\\.json$", "^db/migrations/", "(^|/)openapi\\.json$"],
  "secretFiles": [".env", ".env.local"],
  "network": { "allowedDomains": ["registry.npmjs.org"] },
  "docsCheck": "npm run check:docs"
}
